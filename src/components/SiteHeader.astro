---
import { site } from '../config/site';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/" aria-label={`${site.name} — на главную`}>
      <span class="site-header__prompt" aria-hidden="true">&gt;_</span>
      {site.name}
    </a>
    <nav aria-label="Основное меню">
      <ul class="site-header__nav">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="site-header__phone" href={`tel:${site.contacts.phoneHref}`}>{site.contacts.phone}</a>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--border-width) solid var(--color-line);
    background: var(--color-paper);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    padding-block: var(--space-4);
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
  }

  .site-header__prompt {
    padding: 0 var(--space-1);
    background: var(--color-signal);
    color: var(--color-signal-ink);
    border-radius: var(--radius-sm);
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__nav a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .site-header__phone {
    font-weight: 600;
    color: var(--color-ink);
    white-space: nowrap;
  }

  @media (min-width: 64rem) {
    .site-header__inner {
      flex-wrap: nowrap;
    }

    .site-header__phone {
      margin-left: auto;
    }
  }
</style>
